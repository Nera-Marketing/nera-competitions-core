{#
  CountdownTimer — view data contract (authoritative source: index.php get_data() PHPDoc)
  Child themes may override this view; data is provided by the parent's get_data().
  key             type    req/opt   default   note
  countdown_date  string  required  ''        passed to data-time for JS plugin
  countdown_ms    int     optional  0         target instant (ms since epoch) for the Alpine countdown
  days            string  required  '00'      zero-padded days
  hours           string  required  '00'      zero-padded hours
  minutes         string  required  '00'      zero-padded minutes
  seconds         string  required  '00'      zero-padded seconds
  is_expired      bool    required  false     switches expired variant
  opens_in        bool    required  false     counts to the start; neutral label
#}
{# CountdownTimer atom #}
{# Variables: countdown_date (string|null), is_expired (bool), opens_in (bool), days, hours, minutes, seconds #}

<div class="flex items-center gap-2 mb-3">
  {% if is_expired %}
    <span class="material-symbols-outlined text-gray-400 text-lg">lock</span>
    <span class="text-xs font-bold text-text-secondary uppercase tracking-wider">
      Competition Closed
    </span>
  {% elseif opens_in %}
    <span class="material-symbols-outlined text-text-secondary text-lg">schedule</span>
    <span class="text-xs font-bold text-text-secondary uppercase tracking-wider">
      Opens In
    </span>
  {% else %}
    <span class="material-symbols-outlined text-danger text-lg">schedule</span>
    <span class="text-xs font-bold text-danger uppercase tracking-wider">
      Closes In
    </span>
  {% endif %}
</div>

{% if (countdown_ms or countdown_date) and not is_expired %}
  {# Active variant: with countdown_ms the Alpine countdown counts to an absolute instant and
     reloads the page at zero; without it the lty plugin script drives it through data-time #}
  {% if countdown_ms %}
  <div class="competition-countdown grid grid-cols-4 gap-3"
    x-data="countdown('{{ countdown_ms }}')"
    {# Reload only when the timer was still running at page load: a page served while the
       draw is not closed yet would otherwise reload in a loop. #}
    x-init="$el.dataset.live = endTime > Date.now() ? '1' : ''"
    x-on:nera:countdown:end="$el.dataset.live && window.location.reload()">
  {% else %}
  <div class="lty-lottery-countdown-timer competition-countdown grid grid-cols-4 gap-3"
    data-time="{{ countdown_date }}">
  {% endif %}
    <div class="text-center">
      <div class="bg-primary rounded-xl p-3 lg:p-6">
        <span class="{% if not countdown_ms %}lty-lottery-timer-content {% endif %}block text-2xl lg:text-3xl font-bold !text-white"
          {% if countdown_ms %}x-text="days"{% else %}id="lty_lottery_days"{% endif %}>
          {{ days }}
        </span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Days
      </span>
    </div>
    <div class="text-center">
      <div class="bg-primary rounded-xl p-3 lg:p-6">
        <span class="{% if not countdown_ms %}lty-lottery-timer-content {% endif %}block text-2xl lg:text-3xl font-bold !text-white"
          {% if countdown_ms %}x-text="hours"{% else %}id="lty_lottery_hours"{% endif %}>
          {{ hours }}
        </span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Hours
      </span>
    </div>
    <div class="text-center">
      <div class="bg-primary rounded-xl p-3 lg:p-6">
        <span class="{% if not countdown_ms %}lty-lottery-timer-content {% endif %}block text-2xl lg:text-3xl font-bold !text-white"
          {% if countdown_ms %}x-text="minutes"{% else %}id="lty_lottery_minutes"{% endif %}>
          {{ minutes }}
        </span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Mins
      </span>
    </div>
    <div class="text-center">
      <div class="bg-primary rounded-xl p-3 lg:p-6">
        <span class="{% if not countdown_ms %}lty-lottery-timer-content {% endif %}block text-2xl lg:text-3xl font-bold !text-white"
          {% if countdown_ms %}x-text="seconds"{% else %}id="lty_lottery_seconds"{% endif %}>
          {{ seconds }}
        </span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Secs
      </span>
    </div>
  </div>

{% elseif is_expired %}
  {# Expired variant: static 00s, no plugin classes or data-time #}
  <div class="grid grid-cols-4 gap-3">
    <div class="text-center">
      <div class="bg-primary/40 rounded-xl p-3 lg:p-6">
        <span class="block text-2xl lg:text-3xl font-bold text-white">00</span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Days
      </span>
    </div>
    <div class="text-center">
      <div class="bg-primary/40 rounded-xl p-3 lg:p-6">
        <span class="block text-2xl lg:text-3xl font-bold text-white">00</span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Hours
      </span>
    </div>
    <div class="text-center">
      <div class="bg-primary/40 rounded-xl p-3 lg:p-6">
        <span class="block text-2xl lg:text-3xl font-bold text-white">00</span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Mins
      </span>
    </div>
    <div class="text-center">
      <div class="bg-primary/40 rounded-xl p-3 lg:p-6">
        <span class="block text-2xl lg:text-3xl font-bold text-white">00</span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Secs
      </span>
    </div>
  </div>

{% else %}
  {# Fallback variant: no countdown date available, -- placeholders #}
  <div class="grid grid-cols-4 gap-3">
    <div class="text-center">
      <div class="bg-primary rounded-xl p-3 lg:p-4">
        <span class="block text-2xl lg:text-3xl font-bold text-white">--</span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Days
      </span>
    </div>
    <div class="text-center">
      <div class="bg-primary rounded-xl p-3 lg:p-4">
        <span class="block text-2xl lg:text-3xl font-bold text-white">--</span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Hours
      </span>
    </div>
    <div class="text-center">
      <div class="bg-primary rounded-xl p-3 lg:p-4">
        <span class="block text-2xl lg:text-3xl font-bold text-white">--</span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Mins
      </span>
    </div>
    <div class="text-center">
      <div class="bg-primary rounded-xl p-3 lg:p-4">
        <span class="block text-2xl lg:text-3xl font-bold text-white">--</span>
      </div>
      <span class="block mt-2 text-xs font-semibold text-text-secondary uppercase tracking-wide">
        Secs
      </span>
    </div>
  </div>
{% endif %}
