{#
  SkillQuestionAnswer — view data contract (authoritative source: index.php get_data() PHPDoc)
  Child themes may override this view; data is provided by the parent's get_data().
  key             type                              req/opt   default   note
  question_text   string                            required  ''        question prompt text
  answers         list<{key:string,label:string}>   required  []        normalized answer options
  cart_answer_id  string                            required  ''        pre-selected answer key (unused in view)
  qa_can_display  bool                              required  false     gates active vs not-started variant
#}
{# SkillQuestionAnswer atom #}
{# Variables: qa_can_display (bool), question_text, answers (array of {key, label}) #}
{# Note: the wrapping <form> element stays in the orchestrator — this atom is the inner content only #}

{% if qa_can_display %}
  {# Active variant: Q&A can display, render radio list #}
  <div class="bg-background-light rounded-xl p-6 mb-6 skill-challenge-wrapper border border-gray-100">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary">
        <span class="material-symbols-outlined text-xl">psychology</span>
      </div>
      <h4 class="font-bold text-text-primary uppercase text-sm tracking-wide">
        Question Answers
      </h4>
    </div>

    <div class="nera-contest-qa-container mb-5">
      <div class="nera-contest-question font-medium text-text-primary text-lg mb-4">
        {{ question_text }}
      </div>

      {# interactive=false: Alpine never boots inside the jQuery-modal popup, so
         x-cloak would leave the whole list at display:none and @click would
         never bind. That variant ships plain markup keyed by data attributes;
         selection state is a data-nera-qa-selected flag styled from CSS. #}
      <ul class="nera-contest-answers flex flex-col gap-3"{% if interactive %} x-cloak{% endif %}>
        {% for answerId, answer in answers %}
          {% set optionKey = answer.key is defined ? answer.key : answerId %}
          <li class="relative group cursor-pointer"
            {% if interactive %}
              @click="selectAnswer('{{ optionKey }}')"
            {% else %}
              data-nera-qa-option="{{ optionKey }}"
              data-nera-qa-selected="{{ optionKey == cart_answer_id ? 'yes' : 'no' }}"
            {% endif %}>

            {# The static fallback classes must NOT be emitted alongside :class.
               Alpine merges :class into the existing attribute rather than
               replacing it, so leaving border-gray-200 / bg-surface on an
               Alpine-bound element leaves both the selected and unselected
               colours applied at once, and which one wins depends on stylesheet
               order — the card highlighted while its radio stayed unfilled. #}
            <div class="flex items-center p-4 bg-surface border-2 rounded-xl transition-all duration-200{% if not interactive %} border-gray-200 hover:border-primary/50{% endif %}"
              {% if interactive %}:class="selectedAnswer === '{{ optionKey }}' ? 'border-primary ring-1 ring-primary/20 shadow-sm' : 'border-gray-200 hover:border-primary/50'"{% endif %}>
              {# Radio Circle #}
              <div
                class="w-6 h-6 rounded-full border-2 mr-4 flex items-center justify-center flex-shrink-0 transition-colors{% if not interactive %} border-gray-300 group-hover:border-primary/50 bg-surface{% endif %}"
                {% if interactive %}:class="selectedAnswer === '{{ optionKey }}' ? 'border-primary bg-primary' : 'border-gray-300 group-hover:border-primary/50 bg-surface'"{% endif %}>
                <div class="w-2.5 h-2.5 rounded-full bg-surface transition-opacity duration-200{% if not interactive %} opacity-0{% endif %}"
                  {% if interactive %}:class="selectedAnswer === '{{ optionKey }}' ? 'opacity-100' : 'opacity-0'"{% endif %}>
                </div>
              </div>

              {# Label #}
              <span class="text-base font-medium{% if not interactive %} text-text-secondary group-hover:text-text-primary{% endif %}"
                {% if interactive %}:class="selectedAnswer === '{{ optionKey }}' ? 'text-text-primary' : 'text-text-secondary group-hover:text-text-primary'"{% endif %}>
                {{ answer.label }}
              </span>
            </div>

            {# Keep submitted key aligned with lottery plugin request parsing #}
            <input type="radio" {% if interactive %}name="lty_question_answer_id" {% endif %}value="{{ optionKey }}"
              {% if interactive %}:checked="selectedAnswer === '{{ optionKey }}'"{% endif %} class="sr-only"
              style="display:none !important;" />
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>

{% else %}
  {# Not-yet-started variant: Q&A configured but competition not started #}
  <div class="border border-gray-200 rounded-xl p-5 mb-6 skill-challenge-wrapper">
    <div class="flex items-center gap-2 mb-4">
      <span class="material-symbols-outlined text-primary text-lg">psychology</span>
      <h4 class="font-bold text-text-primary uppercase text-sm tracking-wide">
        Question Answers
      </h4>
    </div>
    <p class="text-sm text-text-secondary">
      The question answers will be available once the competition starts.
    </p>
  </div>
{% endif %}
